TELEGRAM_BOT_TOKEN=
UMAG_PHONE=+7XXXXXXXXXX
UMAG_PASSWORD=
# comma-separated Telegram user IDs allowed to use the bot; empty = anyone
ALLOWED_TELEGRAM_USER_IDS=

# Postgres connection string for the KPI dashboard's database (Neon).
# Leave empty to disable the daily UMAG -> dashboard sales sync.
DASHBOARD_DATABASE_URL=

# Local time (server's timezone) for the daily sync, 24h format.
SYNC_HOUR=21
SYNC_MINUTE=30

# Telegram user IDs to notify with the daily sync summary.
# Defaults to ALLOWED_TELEGRAM_USER_IDS if left empty.
SYNC_NOTIFY_USER_IDS=
